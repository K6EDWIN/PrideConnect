    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^2.4.3",
    "next": "16.3.1",
    "next-auth": "^4.24.7",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "^8.22.0"
  },
  "devDependencies": {
