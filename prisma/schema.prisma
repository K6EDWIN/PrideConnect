// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- ENUMS ----------

enum UserRole {
  ALUMNI
  STAFF
  FORMER_STAFF
  FREQUENT_FLYER
  ADMIN
}

enum TwoFactorMethod {
  AUTHENTICATOR
  EMAIL
}

enum TwoFactorPurpose {
  LOGIN
  SETUP
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MentorshipRole {
  MENTOR
  MENTEE
  BOTH
}

enum MLModelType {
  ACCEPTANCE
  RELEVANCE
  NCF
}

enum MentorshipTopicDirection {
  SEEKING
  OFFERING
}

enum FeedbackType {
  MATCH_RELEVANCE
  MENTORSHIP_USEFULNESS
  CONNECTION_USEFULNESS
}

enum ReportTargetType {
  USER
  OPPORTUNITY
  EVENT
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum FrequentFlyerVerificationStatus {
  PENDING
  RECORDS_MATCHED
  NOT_CONFIRMED
}

enum NotificationEmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

// ---------- CORE USER & PROFILE ----------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          UserRole
  isVerified    Boolean  @default(false)
  isSuspended   Boolean  @default(false)
  isDemo        Boolean  @default(false)
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  passwordChangedAt DateTime?
  sessionVersion Int      @default(0)
  twoFactorEnabled Boolean @default(false)
  twoFactorMethod TwoFactorMethod?
  twoFactorSecretEncrypted String?
  twoFactorPendingSecretEncrypted String?
  twoFactorSetupExpiresAt DateTime?
  twoFactorLastCounter BigInt?
  twoFactorSetupAttempts Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile       Profile?
  sessions      AuthSession[]
  verificationTokens VerificationToken[]
  passwordResetToken PasswordResetToken?

  sentMentorshipRequests     MentorshipRequest[] @relation("MentorshipSender")
  receivedMentorshipRequests MentorshipRequest[] @relation("MentorshipReceiver")

  sentConnectionRequests     ConnectionRequest[] @relation("ConnectionSender")
  receivedConnectionRequests ConnectionRequest[] @relation("ConnectionReceiver")

  recommendationsReceived Recommendation[] @relation("RecommendationOwner")
  recommendationsAsMatch  Recommendation[] @relation("RecommendationMatch")
  recommendationEvents RecommendationEvent[]

  feedbackGiven Feedback[]

  opportunitiesPosted Opportunity[]
  eventsCreated       Event[]
  eventParticipations EventParticipant[]

  flightReconnects FlightReconnect[]

  notifications Notification[]
  frequentFlyerVerification FrequentFlyerVerification? @relation("FrequentFlyerEvidence")
  frequentFlyerReviews FrequentFlyerVerification[] @relation("FrequentFlyerReviewer")
  twoFactorChallenges TwoFactorChallenge[]
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]

  conversationsAsParticipantOne Conversation[] @relation("ConversationParticipantOne")
  conversationsAsParticipantTwo Conversation[] @relation("ConversationParticipantTwo")
  messagesSent                  Message[]

  adminActions AdminAction[]
  submittedReports Report[] @relation("ReportReporter")
  moderatedReports Report[] @relation("ReportModerator")
}

model Profile {
  id                   String          @id @default(cuid())
  userId               String          @unique
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName             String
  bio                  String?
  department            String?
  professionalBackground String?
  trainingHistory       String?
  careerGoals           String?
  mentorshipNeeds       String?
  mentorshipRole         MentorshipRole?
  availability           String?
  isPublic               Boolean         @default(true)
  avatarUrl              String?
  coverImageUrl          String?
  coverPositionX         Int             @default(50)
  coverPositionY         Int             @default(50)

  skills               ProfileSkill[]
  interests            ProfileInterest[]
  mentorshipTopics     ProfileMentorshipTopic[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isPublic, department])
}

model Skill {
  id       String         @id @default(cuid())
  name     String         @unique
  profiles ProfileSkill[]
  mentorshipTopics ProfileMentorshipTopic[]
}

model ProfileMentorshipTopic {
  profileId String
  skillId   String
  direction MentorshipTopicDirection

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId, direction])
  @@index([skillId, direction])
}

model ProfileSkill {
  profileId String
  skillId   String

  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@index([skillId])
}

model Interest {
  id       String            @id @default(cuid())
  name     String            @unique
  profiles ProfileInterest[]
}

model ProfileInterest {
  profileId  String
  interestId String

  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([profileId, interestId])
  @@index([interestId])
}

// ---------- MENTORSHIP & NETWORKING ----------

model MentorshipRequest {
  id         String        @id @default(cuid())
  senderId   String
  receiverId String
  message    String?
  status     RequestStatus @default(PENDING)
  modelFeatures Json?         // Numeric feature snapshot used after outcome is known.
  completedAt DateTime?
  recommendationId String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  sender     User @relation("MentorshipSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User @relation("MentorshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  feedback   Feedback[]
}

model ConnectionRequest {
  id         String        @id @default(cuid())
  senderId   String
  receiverId String
  status     RequestStatus @default(PENDING)
  modelFeatures Json?         // Numeric feature snapshot used after outcome is known.
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  sender     User @relation("ConnectionSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  feedback   Feedback[]
}

// ---------- RECOMMENDATION ENGINE ----------

model Recommendation {
  id                 String   @id @default(cuid())
  ownerId            String
  matchedUserId      String

  contentScore       Float
  collaborativeScore Float
  hybridScore        Float
  semanticScore      Float    @default(0)
  modelFeatures      Json?

  rank               Int?
  createdAt          DateTime @default(now())

  owner              User @relation("RecommendationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  matchedUser        User @relation("RecommendationMatch", fields: [matchedUserId], references: [id], onDelete: Cascade)

  feedback           Feedback[]
  events             RecommendationEvent[]
  mentorshipRequests MentorshipRequest[]

  @@unique([ownerId, matchedUserId])
}

model RecommendationEvent {
  id               String   @id @default(cuid())
  ownerId          String
  recommendationId String
  eventType        String
  rank             Int?
  policy           String?
  selectionProbability Float?
  scores           Json?
  dedupeKey        String?  @unique
  createdAt        DateTime @default(now())

  owner            User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([ownerId, eventType, createdAt])
  @@index([recommendationId, eventType, createdAt])
}

model Feedback {
  id               String   @id @default(cuid())
  userId           String
  recommendationId String?
  mentorshipRequestId String?
  connectionRequestId String?

  feedbackType     FeedbackType @default(MATCH_RELEVANCE)
  rating           Int
  comment          String?
  modelFeatures    Json?
  createdAt        DateTime @default(now())

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendation   Recommendation?  @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  mentorshipRequest MentorshipRequest? @relation(fields: [mentorshipRequestId], references: [id], onDelete: Cascade)
  connectionRequest ConnectionRequest? @relation(fields: [connectionRequestId], references: [id], onDelete: Cascade)

  @@index([feedbackType, createdAt])
  @@index([recommendationId, userId, feedbackType])
}

model MLModelArtifact {
  id             String      @id @default(cuid())
  type           MLModelType
  version        String
  featureNames   Json
  weights        Json
  bias           Float
  sampleCount    Int
  positiveCount  Int
  negativeCount  Int
  confidence     Float       @default(0)
  metrics        Json?
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())

  @@index([type, active, createdAt])
}

// ---------- OPPORTUNITIES & EVENTS ----------

model Opportunity {
  id          String   @id @default(cuid())
  postedById  String
  title       String
  description String
  type        String
  sourceUrl   String?
  expiresAt   DateTime?
  division    String?
  employmentType String?
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())

  postedBy    User @relation(fields: [postedById], references: [id], onDelete: Cascade)
}

model Event {
  id          String   @id @default(cuid())
  createdById String
  title       String
  description String?
  location    String?
  bannerUrl   String?
  photoUrls   String[] @default([])
  eventDate   DateTime
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())

  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  participants EventParticipant[]
}

model EventParticipant {
  eventId String
  userId  String
  joinedAt DateTime @default(now())

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

// ---------- FLIGHT RECONNECT ----------

model FlightReconnect {
  id         String   @id @default(cuid())
  userId     String
  flightRoute String
  travelDate DateTime
  consentToShare Boolean @default(false)
  createdAt  DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- AUTH & ADMIN ----------

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Email verification tokens issued at registration
model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model TwoFactorChallenge {
  id        String           @id @default(cuid())
  userId    String
  tokenHash String           @unique
  purpose   TwoFactorPurpose
  method    TwoFactorMethod
  codeHash  String?
  attempts  Int              @default(0)
  resendCount Int            @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
}

model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model FrequentFlyerVerification {
  id                 String                          @id @default(cuid())
  userId             String                          @unique
  reviewerId         String?
  evidenceCiphertext String?
  status             FrequentFlyerVerificationStatus @default(PENDING)
  reviewedAt         DateTime?
  reviewNote         String?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  user     User  @relation("FrequentFlyerEvidence", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("FrequentFlyerReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model AdminAction {
  id          String   @id @default(cuid())
  adminId     String
  actionType  String
  targetId    String?
  notes       String?
  createdAt   DateTime @default(now())

  admin       User @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailDelivery NotificationEmailDelivery?

  @@index([userId, readAt, createdAt])
}

model NotificationEmailDelivery {
  id             String                  @id @default(cuid())
  notificationId String                  @unique
  status         NotificationEmailStatus @default(PENDING)
  attempts       Int                     @default(0)
  nextAttemptAt  DateTime                @default(now())
  processingAt   DateTime?
  deliveredAt    DateTime?
  lastError      String?                 @db.VarChar(500)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt])
}

model Conversation {
  id               String   @id @default(cuid())
  participantOneId String
  participantTwoId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  participantOne User @relation("ConversationParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwo User @relation("ConversationParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([participantOneId, participantTwoId])
  @@index([participantOneId, updatedAt])
  @@index([participantTwoId, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String   @db.VarChar(2000)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Report {
  id            String           @id @default(cuid())
  reporterId    String
  targetType    ReportTargetType
  targetId      String
  reason        String
  description   String?          @db.VarChar(1000)
  status        ReportStatus     @default(OPEN)
  moderatorId   String?
  moderatorNote String?          @db.VarChar(1000)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  resolvedAt    DateTime?

  reporter  User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  moderator User? @relation("ReportModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model RateLimitBucket {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime @default(now())
  expiresAt       DateTime

  @@index([expiresAt])
}
